# Projeto Supabase do Treino (NÃO é o do Personal Perto)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Cadastro aberto: "true" mostra "Criar conta" na tela de login. "false"
# esconde o cadastro público (só entra quem já tem conta ou for convidado
# manualmente em Supabase > Authentication > Users > Invite user).
VITE_ALLOW_SIGNUP=true

# Opcional: site key do Cloudflare Turnstile pra anti-spam no cadastro. Sem
# essa variável, o cadastro funciona sem captcha (bom pra dev). Veja o README
# pra como gerar a chave e ativar em Supabase > Authentication > Attack Protection.
VITE_TURNSTILE_SITE_KEY=
