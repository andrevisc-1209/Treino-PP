# Projeto Supabase do Treino (NÃO é o do Personal Perto)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Cadastro aberto: "true" mostra "Criar conta" na tela de login. "false"
# esconde o cadastro público (só entra quem já tem conta ou for convidado
# manualmente em Supabase > Authentication > Users > Invite user).
VITE_ALLOW_SIGNUP=true

# Opcional: site key do Cloudflare Turnstile pra anti-spam no cadastro, login,
# "esqueci minha senha" e reenvio de confirmação. Sem essa variável, esses
# fluxos funcionam sem captcha (bom pra dev). Veja docs/CAPTCHA.md pra como
# gerar a chave e ativar em Supabase > Authentication > Attack Protection —
# a ordem de ativação importa, leia o docs/CAPTCHA.md antes de mexer.
VITE_TURNSTILE_SITE_KEY=

# Opcional: API key do Google Maps (Places API habilitada) pro autocomplete de
# "Local de treino" no cadastro do aluno. Sem essa variável, o campo vira um
# texto livre normal, sem sugestões. Restrinja a key por referrer HTTP
# (treino.personalperto.com.br e localhost) no Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
