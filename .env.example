# Projeto Supabase do Treino (NÃO é o do Personal Perto)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# "true" mostra "Criar conta" na tela de login (útil em dev).
# Em produção, deixe "false": acesso só por convite (Supabase > Authentication > Users > Invite user).
VITE_ALLOW_SIGNUP=false
